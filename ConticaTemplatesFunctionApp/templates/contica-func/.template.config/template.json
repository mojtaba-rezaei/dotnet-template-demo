{
  "$schema": "http://json.schemastore.org/template",
  "author": "Contica",
  "classifications": [
    "Azure Functions",
    "Cloud"
  ],
  "identity": "Contica.FunctionApp.Template",
  "groupIdentity": "Contica.FunctionApp",
  "precedence": 100,
  "name": "Contica Template - Azure Function App",
  "shortName": "contica-func",
  "description": "A .NET 10 isolated-process Azure Function App following Contica standards.",
  "tags": {
    "language": "C#",
    "type": "project"
  },
  "sourceName": "ProjectName",
  "preferNameDirectory": true,
  "defaultName": "ConticaFunctionApp",
  "icons": {
    "default": "icon.png"
  },
  "constraints": {
    "sdk-version": {
      "type": "sdk-version",
      "args": "10.0.0"
    }
  },
  "primaryOutputs": [
    {
      "path": "src/ProjectName-FunctionApp/Functions/TimeFunction.cs",
      "condition": "(HttpTrigger)"
    },
    {
      "path": "src/ProjectName-FunctionApp/Functions/BlobProcessorFunction.cs",
      "condition": "(BlobTrigger && !HttpTrigger)"
    },
    {
      "path": "src/ProjectName-FunctionApp/Functions/ServiceBusMessageFunction.cs",
      "condition": "(ServiceBusTrigger && !HttpTrigger && !BlobTrigger)"
    },
    {
      "path": "src/ProjectName-FunctionApp/Functions/ScheduledTaskFunction.cs",
      "condition": "(TimerTrigger && !HttpTrigger && !BlobTrigger && !ServiceBusTrigger)"
    },
    {
      "path": "src/ProjectName-FunctionApp/Functions/QueueMessageFunction.cs",
      "condition": "(QueueTrigger && !HttpTrigger && !BlobTrigger && !ServiceBusTrigger && !TimerTrigger)"
    }
  ],
  "symbols": {
    "HttpTrigger": {
      "type": "parameter",
      "datatype": "bool",
      "defaultValue": "true",
      "description": "Include HTTP trigger function (GET /api/time)."
    },
    "BlobTrigger": {
      "type": "parameter",
      "datatype": "bool",
      "defaultValue": "false",
      "description": "Include Blob trigger function."
    },
    "ServiceBusTrigger": {
      "type": "parameter",
      "datatype": "bool",
      "defaultValue": "false",
      "description": "Include Service Bus trigger function."
    },
    "TimerTrigger": {
      "type": "parameter",
      "datatype": "bool",
      "defaultValue": "false",
      "description": "Include Timer trigger function."
    },
    "QueueTrigger": {
      "type": "parameter",
      "datatype": "bool",
      "defaultValue": "false",
      "description": "Include Queue trigger function."
    },
    "AnyTrigger": {
      "type": "computed",
      "value": "(HttpTrigger || BlobTrigger || ServiceBusTrigger || TimerTrigger || QueueTrigger)"
    },
    "IncludeSolution": {
      "type": "parameter",
      "datatype": "bool",
      "defaultValue": "true",
      "description": "Include solution file (.slnx). Set to false when adding to an existing solution."
    },
    "IncludeTests": {
      "type": "parameter",
      "datatype": "bool",
      "defaultValue": "true",
      "description": "Include test project. Set to false to exclude tests."
    },
    "StandaloneProject": {
      "type": "computed",
      "value": "(!IncludeSolution && !IncludeTests)"
    }
  },
  "sources": [
    {
      "modifiers": [
        {
          "condition": "(!AnyTrigger)",
          "exclude": [
            "src/ProjectName-FunctionApp/**/*",
            "tests/**/*"
          ]
        },
        {
          "condition": "(!HttpTrigger)",
          "exclude": [
            "src/ProjectName-FunctionApp/Functions/TimeFunction.cs",
            "src/ProjectName-FunctionApp/Services/ITimeService.cs",
            "src/ProjectName-FunctionApp/Services/TimeService.cs",
            "src/ProjectName-FunctionApp/Models/TimeResponse.cs",
            "tests/ProjectName.FunctionApp.Tests/Unit/TimeFunctionTests.cs",
            "tests/ProjectName.FunctionApp.Tests/Unit/TimeServiceTests.cs"
          ]
        },
        {
          "condition": "(!BlobTrigger)",
          "exclude": [
            "src/ProjectName-FunctionApp/Functions/BlobProcessorFunction.cs",
            "src/ProjectName-FunctionApp/Services/IBlobProcessorService.cs",
            "src/ProjectName-FunctionApp/Services/BlobProcessorService.cs",
            "src/ProjectName-FunctionApp/Models/BlobProcessingResult.cs",
            "tests/ProjectName.FunctionApp.Tests/Unit/BlobProcessorFunctionTests.cs",
            "tests/ProjectName.FunctionApp.Tests/Unit/BlobProcessorServiceTests.cs"
          ]
        },
        {
          "condition": "(!ServiceBusTrigger)",
          "exclude": [
            "src/ProjectName-FunctionApp/Functions/ServiceBusMessageFunction.cs",
            "src/ProjectName-FunctionApp/Services/IServiceBusMessageService.cs",
            "src/ProjectName-FunctionApp/Services/ServiceBusMessageService.cs",
            "src/ProjectName-FunctionApp/Models/ServiceBusMessageResult.cs",
            "tests/ProjectName.FunctionApp.Tests/Unit/ServiceBusMessageFunctionTests.cs",
            "tests/ProjectName.FunctionApp.Tests/Unit/ServiceBusMessageServiceTests.cs"
          ]
        },
        {
          "condition": "(!TimerTrigger)",
          "exclude": [
            "src/ProjectName-FunctionApp/Functions/ScheduledTaskFunction.cs",
            "src/ProjectName-FunctionApp/Services/IScheduledTaskService.cs",
            "src/ProjectName-FunctionApp/Services/ScheduledTaskService.cs",
            "src/ProjectName-FunctionApp/Models/ScheduledTaskResult.cs",
            "tests/ProjectName.FunctionApp.Tests/Unit/ScheduledTaskFunctionTests.cs",
            "tests/ProjectName.FunctionApp.Tests/Unit/ScheduledTaskServiceTests.cs"
          ]
        },
        {
          "condition": "(!QueueTrigger)",
          "exclude": [
            "src/ProjectName-FunctionApp/Functions/QueueMessageFunction.cs",
            "src/ProjectName-FunctionApp/Services/IQueueMessageService.cs",
            "src/ProjectName-FunctionApp/Services/QueueMessageService.cs",
            "src/ProjectName-FunctionApp/Models/QueueMessageResult.cs",
            "tests/ProjectName.FunctionApp.Tests/Unit/QueueMessageFunctionTests.cs",
            "tests/ProjectName.FunctionApp.Tests/Unit/QueueMessageServiceTests.cs"
          ]
        },
        {
          "condition": "(!IncludeSolution)",
          "exclude": [
            "src/ProjectName.slnx"
          ]
        },
        {
          "condition": "(!IncludeTests)",
          "exclude": [
            "tests/**/*"
          ]
        },
        {
          "condition": "(StandaloneProject)",
          "exclude": [
            "src/.editorconfig"
          ]
        },
        {
          "condition": "(!StandaloneProject)",
          "exclude": [
            "src/ProjectName-FunctionApp/.editorconfig"
          ]
        }
      ]
    }
  ],
  "postActions": [
    {
      "condition": "(AnyTrigger)",
      "description": "Restore NuGet packages",
      "manualInstructions": [
        {
          "text": "Run 'dotnet restore'"
        }
      ],
      "actionId": "210D431B-A78B-4D2F-B762-4ED3E3EA9025",
      "continueOnError": true
    }
  ]
}
