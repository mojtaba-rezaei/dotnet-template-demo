<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageType>Template</PackageType>
    <PackageId>contica.templates.func</PackageId>
    <SuppressDependenciesWhenPacking>true</SuppressDependenciesWhenPacking>
    <NoWarn>$(NoWarn);NU5128</NoWarn>
    <Title>Contica Azure Function App Template</Title>
    <Authors>Contica AB</Authors>
    <Description>A dotnet new template for creating .NET 10 isolated-process Azure Function Apps following Contica standards.</Description>
    <PackageTags>dotnet-new;templates;azure;functions;contica;isolated-worker</PackageTags>
    <PackageProjectUrl>https://github.com/Contica-AB</PackageProjectUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>content/.template.config/icon.png</PackageIcon>
    <RepositoryUrl>https://github.com/Contica-AB/contica-integration-sdk</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <Copyright>Copyright © Contica AB 2026</Copyright>
    <Company>Contica AB</Company>
    <PackageReleaseNotes>Initial release with HTTP, Blob, ServiceBus, Timer, and Queue triggers.</PackageReleaseNotes>
    <TargetFramework>net10.0</TargetFramework>
    <IncludeContentInPack>true</IncludeContentInPack>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <ContentTargetFolders>content</ContentTargetFolders>
    <NoDefaultExcludes>true</NoDefaultExcludes>
    <Version>1.0.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <Content Include=".template.config\**\*;src\**\*;tests\**\*" Exclude="**\bin\**;**\obj\**" />
    <Compile Remove="**\*" />
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
